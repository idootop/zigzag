{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限。按最小必要授予：能弹目录选择框、能在 Finder 里打开路径、能拖动窗口，仅此而已。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:allow-open",
    "shell:default"
  ]
}
